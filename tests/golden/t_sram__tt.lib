    pin (D1) {
      direction : input;
      capacitance : 0.001800;
      related_power_pin : VPWR;
      related_ground_pin : VGND;
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint (vyges_macro_constraint) {
          values ( \
            "0.100000, 0.200000, 0.300000", \
