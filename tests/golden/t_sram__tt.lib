            "0.080000, 0.090000, 0.100000" );
        }
      }
    }
    pin (Q0) {
      direction : output;
      max_capacitance : 0.05;
      related_power_pin : VPWR;
      related_ground_pin : VGND;
      timing () {
        related_pin : "CLK";
        timing_type : falling_edge;
        timing_sense : non_unate;
        cell_rise (vyges_macro_load) {
          values ( \
            "2.500000, 2.600000, 2.900000" );
        }
        rise_transition (vyges_macro_load) {
          values ( \
            "0.050000, 0.120000, 0.400000" );
        }
        cell_fall (vyges_macro_load) {
          values ( \
            "2.400000, 2.500000, 2.800000" );
        }
        fall_transition (vyges_macro_load) {
          values ( \
            "0.040000, 0.100000, 0.350000" );
        }
      }
    }
    pin (Q1) {
      direction : output;
      max_capacitance : 0.05;
      related_power_pin : VPWR;
      related_ground_pin : VGND;
      timing () {
